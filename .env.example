DATABASE_URL="postgresql://postgres:your-db-password@localhost:5432/wa_enterprise"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars for AES-256-GCM)
ENCRYPTION_KEY="replace-with-64-char-hex-string"

ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your-strong-password"

# Required: found in Meta App Dashboard → App Settings → Basic → App Secret
# Enables HMAC-SHA256 signature verification on incoming webhook events.
WHATSAPP_APP_SECRET="your-meta-app-secret"
